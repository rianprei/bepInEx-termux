<?xml version="1.0" encoding="utf-8"?>
<!-- Sem android:versionCode/versionName aqui de proposito: a versao vem do
     VERSION da raiz do repo e entra no link pelo aapt2 (flags version-code e
     version-name em manager/build.sh). Numero solto no manifest e o jeito
     rapido de o APK do Manager saying 0.1.0 enquanto o projeto e v0.4.1. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.rianprei.bepinex.manager">

    <uses-sdk
        android:minSdkVersion="26"
        android:targetSdkVersion="36" />

    <!-- Permissao para listar todos os pacotes instalados no Android 11+ -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />

    <application
        android:label="bepInEx Manager"
        android:icon="@drawable/ic_launcher"
        android:theme="@style/AppTheme"
        android:allowBackup="false"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="bepInEx Manager"
            android:windowSoftInputMode="adjustPan">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Intent filter para abrir arquivos .bmod diretamente de outros apps -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="file" />
                <data android:scheme="content" />
                <data android:mimeType="*/*" />
                <data android:pathPattern=".*\\.bmod" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="file" />
                <data android:scheme="content" />
                <data android:mimeType="application/octet-stream" />
                <data android:pathPattern=".*\\.bmod" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="file" />
                <data android:scheme="content" />
                <data android:mimeType="application/zip" />
                <data android:pathPattern=".*\\.bmod" />
            </intent-filter>
        </activity>

        <activity
            android:name=".GameDetailActivity"
            android:label="@string/title_game_detail"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".LogViewerActivity"
            android:label="@string/title_log_viewer"
            android:parentActivityName=".GameDetailActivity" />

        <activity
            android:name=".ModOptionsActivity"
            android:label="@string/title_mod_options"
            android:parentActivityName=".GameDetailActivity" />

        <activity
            android:name=".ModMakerActivity"
            android:label="@string/title_mod_maker"
            android:parentActivityName=".GameDetailActivity" />

    </application>

</manifest>
