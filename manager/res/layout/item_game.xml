<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="12dp"
    android:gravity="center_vertical">

    <ImageView
        android:id="@+id/img_game_icon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginRight="12dp"
        android:contentDescription="Ícone do app" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_game_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nome do Jogo"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

        <TextView
            android:id="@+id/tv_game_pkg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="com.exemplo.jogo"
            android:textSize="12sp"
            android:textColor="@color/text_muted" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_badge_engine"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Unity (IL2CPP)"
                android:textSize="10sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/badge_engine"
                android:layout_marginRight="8dp" />

            <TextView
                android:id="@+id/tv_mod_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 mods"
                android:textSize="11sp"
                android:textColor="@color/text_secondary" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
