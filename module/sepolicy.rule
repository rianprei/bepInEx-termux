# F1c — SELinux Enforcing. Magisk e KernelSU aplicam este arquivo no boot:
# uma policy statement por linha (Magisk Developer Guides, secao sepolicy.rule:
# https://topjohnwu.github.io/Magisk/guides.html ; KernelSU Module guide:
# https://kernelsu.org/guide/module.html ). A sintaxe e a do magiskpolicy
# (https://github.com/topjohnwu/Magisk/blob/master/native/src/sepolicy/statement.rs):
# "allow <src> <tgt> <class> { <perms> }" e "type <nome> <atributo>". Linhas
# vazias e linhas comecadas em "#" sao ignoradas pelo parser (statement.rs:606).
#
# CONTEXTO DE ROTULO (AOSP platform/system/sepolicy/private/file_contexts):
#   /data/local/tmp(/.*)?  -> shell_data_file   (linha 626)
#   /data/(.*)?            -> system_data_file  (linha 589) — appdomain e
#     zygote ja tem search/getattr nessa arvore, logo /data/local nao e gargalo.
# Entao o unico obstaculo de travessia ate os mods e o /data/local/tmp, e o
# unico obstaculo depois dele e o tipo dos arquivos em si (da pra isso um tipo
# proprio: nao queremos dar leitura de shell_data_file:file pra todo app).
#
# TIPOS DE CONTEXTO (dois, e nao se misturam):
#   zygote    -> o preAppSpecialize roda aqui, antes do dyntransition pro app
#                (AOSP private/zygote.te: "allow zygote appdomain:process
#                dyntransition"). O que o loader faz nessa fase: 1 stat() da
#                pasta de mods (F1 decide_path) e, so se ela nao existir, a
#                leitura da allowlist legada.
#   appdomain -> o processo do jogo depois de specialize (atributo que todo
#                app recebe, AOSP private/app.te). Aqui rodam o scandir() da
#                pasta de mods e o dlopen() dos .so, na thread de carga.

# --- tipo proprio dos arquivos de mod -----------------------------------------
type bepinex_mod_file file_type

# --- zygote: o stat() que decide o caminho ------------------------------------
# search em shell_data_file:dir = entrar em /data/local/tmp.
#
# zygote64 entra na lista porque ate o Android 11 existia um segundo dominio de
# zygote, e em API <= 30 e o que roda o preAppSpecialize. No AOSP atual o tipo
# zygote64 nao existe mais, e isso NAO quebra o arquivo: magiskpolicy expande
# "allow { a b }" no produto cartesiano e chama add_rule() uma vez por par; um
# tipo inexistente so faz aquele par falhar com um LOGW
# (sepolicy.cpp:244 "target type ... does not exist" + api.cpp:59 expand) — o
# resto do sepolicy.rule continua sendo aplicado.
allow { zygote zygote64 } shell_data_file dir search
# getattr + search em bepinex_mod_file:dir = stat() do /mods/<pkg>/ e olhar o
# nome dentro de /mods/ (o stat e do objeto final; o search, do diretorio pai).
allow { zygote zygote64 } bepinex_mod_file dir { getattr search }
# getattr/open/read no conf da allowlist legada (experimento Cocos): o post-fs-data
# chcona esse arquivo pro tipo novo, entao ele nao e mais shell_data_file:file e o
# zygote consegue access() + fopen() nele. Sem isto a allowlist fica muda em
# Enforcing (todo app cairia em DLCLOSE por causa de um conf opcional).
allow { zygote zygote64 } bepinex_mod_file file { getattr open read }

# --- appdomain: scandir() + dlopen() dos mods ---------------------------------
# search em shell_data_file:dir = chegar em /data/local/tmp/mods a partir do
# processo do jogo. Nada de shell_data_file:file: o jogo nao le nada dali, so
# desce na arvore.
allow appdomain shell_data_file dir search
# search/read/open na pasta: scandir() = opendir() (open) + readdir() (read) e
# lookup do nome dos .so (search). getattr cobre o fstat() que o scandir() faz
# no dirfd — preventative, para nao depender da libc do device.
allow appdomain bepinex_mod_file dir { getattr search read open }
# getattr/open/read/map/execute no .so: dlopen() abre e le o arquivo, mmap com
# PROT_EXEC (map) e o SO precisa ser executavel (execute).
allow appdomain bepinex_mod_file file { getattr open read map execute }

# --- W+X: o que Dobby e o u_patch exigem para hookar/patchar ---------------------
# Duas verificacoes SELinux diferentes, e o AOSP ja cobre a primeira:
#  - mmap() anonimo PROT_EXEC (pagina de trampoline do Dobby, pagina de thunks
#    do u_patch) => self:process execmem. O AOSP JA da isso pro appdomain
#    (private/app.te:189, "WebView and other application-specific JIT
#    compilers"). Repetido aqui porque ROM OEM (HyperOS deste device) pode
#    tirar a permissao, e mmap falhando nao deixa log nenhum no jogo.
allow appdomain self:process execmem
#  - mprotect() com +PROT_EXEC na pagina de codigo do jogo => execmod no tipo do
#    arquivo mapeado. As libs do jogo sao apk_data_file
#    (private/file_contexts:611, "/data/app(/.*)?"), e o AOSP da map+execute
#    nelas (private/app.te:443, x_file_perms) mas NAO execmod. Sem esta linha o
#    DobbyHook e o patch in-place do u_patch morrem com EACCES em Enforcing.
allow appdomain apk_data_file:file execmod
# Travessia de /data e /data/local (system_data_file:dir) ate /data/local/tmp:
# o zygote ja tem r_dir_perms nisso (private/zygote.te:36). Para o appdomain o
# AOSP nao tem neverallow cobrindo (o de private/app.te:608 so proibe o grupo
# {create write setattr ...}, o que implica que o resto ja existe), mas nao achei
# a linha que concede — e search e o minimo, custo zero.
allow appdomain system_data_file:dir search
